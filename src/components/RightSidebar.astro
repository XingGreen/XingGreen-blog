---
import BlogActivityOverview from './BlogActivityOverview.astro';

interface Props {
  // 可以根据实际需要添加属性
}

const {} = Astro.props;

// 获取当前日期
const currentDate = new Date();
const currentYear = currentDate.getFullYear();
const currentMonth = currentDate.getMonth(); // 0-11

// 获取月份名称
const monthNames = [
  '一月', '二月', '三月', '四月', '五月', '六月',
  '七月', '八月', '九月', '十月', '十一月', '十二月'
];

// 获取月份的天数
const getDaysInMonth = (year: number, month: number) => {
  return new Date(year, month + 1, 0).getDate();
};

// 获取月份第一天是星期几
const getFirstDayOfMonth = (year: number, month: number) => {
  return new Date(year, month, 1).getDay(); // 0-6, 0是周日
};

// 生成日历数据
const daysInMonth = getDaysInMonth(currentYear, currentMonth);
const firstDayOfMonth = getFirstDayOfMonth(currentYear, currentMonth);
const calendarDays = [];

// 添加空白日期（用于对齐）
for (let i = 0; i < firstDayOfMonth; i++) {
  calendarDays.push(null);
}

// 添加实际日期
for (let i = 1; i <= daysInMonth; i++) {
  calendarDays.push(i);
}
---

<div class="right-sidebar-content">
  <!-- 搜索组件 -->
  <div class="sidebar-card search-card" style="position: relative;">
    <h3 class="sidebar-title">
      <span class="material-symbols-outlined">search</span>
      搜索
    </h3>
    <div class="search-input-wrapper">
      <span class="material-symbols-outlined search-icon">search</span>
      <input 
        type="text" 
        class="search-input" 
        placeholder="搜索文章..."
        aria-label="搜索文章"
        id="sidebar-search-input"
      />
    </div>
    <div class="search-results" id="sidebar-search-results"></div>
  </div>



  <!-- 日历组件 -->
  <div class="sidebar-card calendar-card">
    <h3 class="sidebar-title">
      <span class="material-symbols-outlined">calendar_month</span>
      日历
    </h3>
    <div class="calendar">
      <div class="calendar-header">
        <span class="calendar-month-year">
          {monthNames[currentMonth]} {currentYear}
        </span>
      </div>
      
      <div class="calendar-weekdays">
        <span class="weekday">日</span>
        <span class="weekday">一</span>
        <span class="weekday">二</span>
        <span class="weekday">三</span>
        <span class="weekday">四</span>
        <span class="weekday">五</span>
        <span class="weekday">六</span>
      </div>
      
      <div class="calendar-days">
        {calendarDays.map((day) => (
          <div 
            class={`calendar-day ${day === currentDate.getDate() ? 'current-day' : ''} ${day ? '' : 'empty'}`}
          >
            {day}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 站点信息组件 -->
  <div class="sidebar-card site-info-card">
    <h3 class="sidebar-title">
      <span class="material-symbols-outlined">info</span>
      站点信息
    </h3>
    <div class="site-info">
      <div class="info-item">
        <span class="material-symbols-outlined">description</span>
        <span class="info-label">文章总数:</span>
        <span class="info-value" id="total-posts">0</span>
      </div>
      <div class="info-item">
        <span class="material-symbols-outlined">category</span>
        <span class="info-label">分类总数:</span>
        <span class="info-value" id="total-categories">0</span>
      </div>
      <div class="info-item">
        <span class="material-symbols-outlined">sell</span>
        <span class="info-label">标签总数:</span>
        <span class="info-value" id="total-tags">0</span>
      </div>
    </div>
  </div>

  <!-- 活动概览组件 -->
  <BlogActivityOverview />
</div>

<script is:inline>
  // 确保DOM加载完成后执行JavaScript代码
  document.addEventListener('DOMContentLoaded', () => {
    console.log('RightSidebar search script loaded');
    
    // 获取搜索元素
    const searchInput = document.getElementById('sidebar-search-input');
    const searchResults = document.getElementById('sidebar-search-results');
    
    if (!searchInput || !searchResults) {
      console.error('Search elements not found');
      return;
    }

    // 简单搜索功能（不依赖Fuse.js）
    const performSearch = (query, posts) => {
      if (!query.trim()) {
        searchResults.classList.remove('show');
        return;
      }
      
      // 简单的字符串匹配搜索
      const results = posts.filter(post => 
        `${post.title} ${post.excerpt} ${post.category} ${post.tags.join(' ')}`
          .toLowerCase().includes(query.toLowerCase())
      );
      
      renderSearchResults(results);
    };

    // 渲染搜索结果
    const renderSearchResults = (results) => {
      console.log('Rendering search results:', results.length);
      
      if (results.length === 0) {
        searchResults.innerHTML = `
          <div class="search-result-item">
            <div class="search-result-title">未找到相关文章</div>
            <div class="search-result-excerpt">请尝试其他搜索关键词</div>
          </div>
        `;
        searchResults.classList.add('show');
        return;
      }
      
      const resultsHTML = results.map(post => {
        return `
          <div class="search-result-item" data-slug="${post.slug}">
            <div class="search-result-title">${post.title}</div>
            <div class="search-result-excerpt">${post.excerpt}</div>
            <div class="search-result-meta">
              <span class="search-result-category">${post.category}</span>
              <span class="search-result-date">${post.date}</span>
            </div>
          </div>
        `;
      }).join('');
      
      searchResults.innerHTML = resultsHTML;
      searchResults.classList.add('show');
      
      // 添加结果点击事件
      const resultItems = searchResults.querySelectorAll('.search-result-item');
      resultItems.forEach(item => {
        item.addEventListener('click', () => {
          const slug = item.dataset.slug;
          if (slug) {
            window.location.href = `/blog/${slug}`;
          }
        });
      });
    };

    // 获取博客文章数据
    let blogPosts = [];
    
    // 从全局变量获取文章数据（需要在页面中定义）
    if (window.blogPosts) {
      blogPosts = window.blogPosts;
      console.log('Loaded blog posts:', blogPosts.length);
      
      // 更新站点统计信息
      const totalPostsElement = document.getElementById('total-posts');
      const totalCategoriesElement = document.getElementById('total-categories');
      const totalTagsElement = document.getElementById('total-tags');
      
      if (totalPostsElement) {
        totalPostsElement.textContent = blogPosts.length.toString();
      }
      
      if (totalCategoriesElement) {
        const categories = Array.from(new Set(blogPosts.map(post => post.category)));
        totalCategoriesElement.textContent = categories.length.toString();
      }
      
      if (totalTagsElement) {
        const tags = Array.from(new Set(blogPosts.flatMap(post => post.tags)));
        totalTagsElement.textContent = tags.length.toString();
      }
    }
    
    // 监听输入事件
    let searchTimeout = null;
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value;
      console.log('Search input:', query);
      
      if (searchTimeout) {
        clearTimeout(searchTimeout);
      }
      
      searchTimeout = setTimeout(() => {
        performSearch(query, blogPosts);
      }, 300);
    });
    
    // 确保搜索结果容器有正确的定位
    searchResults.style.position = 'absolute';
    searchResults.style.top = '100%';
    searchResults.style.left = '0';
    searchResults.style.right = '0';
    
    // 点击外部关闭搜索结果
    document.addEventListener('click', (e) => {
      if (e.target instanceof Element && !e.target.closest('.search-card')) {
        searchResults.classList.remove('show');
      }
    });
    
    // 按ESC键关闭搜索结果
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        searchResults.classList.remove('show');
      }
    });
  });
</script>

<style>
.right-sidebar-content {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.sidebar-card {
  background: var(--md3-surface);
  border: 1px solid var(--md3-outline);
  border-radius: var(--border-radius-md);
  padding: 1.5rem;
  box-shadow: var(--shadow-sm);
  transition: var(--transition);
}

.sidebar-card:hover {
  box-shadow: var(--shadow-md);
}

.sidebar-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 1rem;
  color: var(--md3-on-surface);
}

.sidebar-title .material-symbols-outlined {
  font-size: 1.3rem;
  color: var(--md3-primary);
}

/* 搜索组件样式 */
.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 12px;
  color: var(--md3-on-surface-variant);
  font-size: 1.25rem;
  pointer-events: none;
}

.search-input {
  width: 100%;
  padding: 10px 14px 10px 40px;
  border: 1px solid var(--md3-outline);
  border-radius: var(--border-radius-sm);
  background: var(--md3-surface);
  color: var(--md3-on-surface);
  font-size: 0.9rem;
  font-family: inherit;
  transition: all 0.3s cubic-bezier(.4,0,.2,1);
}

.search-input:focus {
  outline: none;
  border-color: var(--md3-primary);
  box-shadow: 0 0 0 3px var(--md3-primary-container);
}

.search-input::placeholder {
  color: var(--md3-on-surface-variant);
}

.search-results {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  margin-top: 8px;
  max-height: 300px;
  overflow-y: auto;
  background: var(--md3-surface);
  border: 1px solid var(--md3-outline);
  border-radius: var(--border-radius-sm);
  box-shadow: var(--shadow-md);
  z-index: 100;
  display: none;
}

.search-results.show {
  display: block;
}

.search-result-item {
  padding: 12px 16px;
  border-bottom: 1px solid var(--md3-outline);
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.search-result-item:last-child {
  border-bottom: none;
  border-radius: 0 0 var(--border-radius-sm) var(--border-radius-sm);
}

.search-result-item:hover {
  background-color: var(--md3-primary-container);
}

.search-result-title {
  font-weight: 500;
  color: var(--md3-on-surface);
  margin-bottom: 4px;
  font-size: 0.9rem;
}

.search-result-excerpt {
  color: var(--md3-on-surface-variant);
  font-size: 0.8rem;
  line-height: 1.5;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.search-result-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 6px;
  font-size: 0.7rem;
  color: var(--md3-on-surface-variant);
}

.search-result-category {
  background-color: var(--md3-primary-container);
  padding: 2px 6px;
  border-radius: 10px;
}

/* 日历组件样式 */
.calendar {
  width: 100%;
}

.calendar-header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 1rem;
}

.calendar-month-year {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--md3-on-surface);
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
  margin-bottom: 0.5rem;
}

.weekday {
  text-align: center;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--md3-on-surface-variant);
  padding: 0.5rem 0;
}

.calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  color: var(--md3-on-surface);
  border-radius: var(--border-radius-sm);
  transition: all 0.3s ease;
  cursor: pointer;
}

.calendar-day:hover {
  background: var(--md3-primary-container);
}

.calendar-day.current-day {
  background: var(--md3-primary);
  color: var(--md3-on-primary);
  font-weight: 600;
  box-shadow: var(--shadow-md);
}

.calendar-day.empty {
  visibility: hidden;
}

/* 站点信息组件样式 */
.site-info {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.9rem;
}

.info-item .material-symbols-outlined {
  font-size: 1.1rem;
  color: var(--md3-primary);
  width: 24px;
}

.info-label {
  color: var(--md3-on-surface-variant);
  flex: 1;
}

.info-value {
  color: var(--md3-on-surface);
  font-weight: 600;
}
</style>
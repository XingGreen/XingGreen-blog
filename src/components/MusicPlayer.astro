---
// 音乐播放控制组件
---

<div class="music-player-container">
  <!-- 固定定位的音乐控制按钮 -->
  <button class="music-control-btn glass" aria-label="打开音乐播放器">
    <span class="material-symbols-outlined">music_note</span>
  </button>

  <!-- 音乐播放器界面 -->
  <div class="music-player glass">
    <!-- 播放器头部 -->
    <div class="player-header">
      <button class="playlist-btn" aria-label="打开播放列表">
        <span class="material-symbols-outlined">queue_music</span>
      </button>
      <h3>音乐播放器</h3>
      <button class="close-btn" aria-label="关闭播放器">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <!-- 播放器主体内容 -->
    <div class="player-content">
      <!-- 左侧：播放控制区域 -->
      <div class="player-left">
        <!-- 歌曲信息 -->
        <div class="song-info">
          <div class="album-cover">
            <span class="material-symbols-outlined">music_note</span>
          </div>
          <div class="song-details">
            <h4 class="song-title">默认歌曲</h4>
            <p class="song-artist">未知艺术家</p>
          </div>
        </div>

        <!-- 播放控制按钮 -->
        <div class="play-controls">
          <button class="control-btn" aria-label="上一曲">
            <span class="material-symbols-outlined">skip_previous</span>
          </button>
          <button class="control-btn play-btn" aria-label="播放">
            <span class="material-symbols-outlined">play_arrow</span>
          </button>
          <button class="control-btn" aria-label="下一曲">
            <span class="material-symbols-outlined">skip_next</span>
          </button>
        </div>

        <!-- 进度条 -->
        <div class="progress-container">
          <span class="time-display current-time">0:00</span>
          <div class="progress-bar">
            <div class="progress-fill"></div>
          </div>
          <span class="time-display total-time">0:00</span>
        </div>

        <!-- 音量控制 -->
        <div class="volume-control">
          <button class="volume-btn" aria-label="静音">
            <span class="material-symbols-outlined">volume_up</span>
          </button>
          <div class="volume-bar">
            <div class="volume-fill"></div>
          </div>
        </div>
      </div>

      <!-- 右侧：歌词显示区域 -->
      <div class="player-right">
        <div class="lyrics-container">
          <div class="lyrics">
            <p>点击播放按钮开始播放音乐</p>
            <p>歌词将在这里同步显示</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 播放列表面板 -->
    <div class="playlist-panel">
      <div class="playlist-header">
        <h4>播放列表</h4>
        <button class="close-playlist-btn" aria-label="关闭播放列表">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="playlist-content">
        <div class="playlist-item active">
          <span class="material-symbols-outlined">music_note</span>
          <div class="playlist-info">
            <div class="playlist-title">默认歌曲</div>
            <div class="playlist-artist">未知艺术家</div>
          </div>
          <span class="material-symbols-outlined">play_arrow</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 背景遮罩 -->
  <div class="music-player-overlay"></div>
</div>

<!-- 下雨效果容器 -->
<div class="rain-container" id="rain-container">
  <!-- 雨滴将通过JavaScript动态生成 -->
</div>

  <!-- 音频元素 -->
<audio id="music-player" loop>
  您的浏览器不支持音频播放功能。
</audio>

<script>
  // 等待DOM加载完成
  document.addEventListener('DOMContentLoaded', () => {
    // 获取DOM元素
    const musicControlBtn = document.querySelector('.music-control-btn');
    const musicPlayer = document.querySelector('.music-player');
    const closeBtn = document.querySelector('.close-btn');
    const playerOverlay = document.querySelector('.music-player-overlay');
    const playBtn = document.querySelector('.play-btn');
    const prevBtn = document.querySelector('.control-btn:nth-child(1)');
    const nextBtn = document.querySelector('.control-btn:nth-child(3)');
    const progressBar = document.querySelector('.progress-bar');
    const progressFill = document.querySelector('.progress-fill');
    const currentTimeEl = document.querySelector('.current-time');
    const totalTimeEl = document.querySelector('.total-time');
    const volumeBtn = document.querySelector('.volume-btn');
    const volumeBar = document.querySelector('.volume-bar');
    const volumeFill = document.querySelector('.volume-fill');
    const playlistBtn = document.querySelector('.playlist-btn');
    const closePlaylistBtn = document.querySelector('.close-playlist-btn');
    const playlistPanel = document.querySelector('.playlist-panel');
    const playlistContent = document.querySelector('.playlist-content');
    const audio = document.getElementById('music-player');
    const lyricsContainer = document.querySelector('.lyrics-container');
    const lyricsEl = document.querySelector('.lyrics');
    const songTitleEl = document.querySelector('.song-title');
    const songArtistEl = document.querySelector('.song-artist');
    const rainContainer = document.getElementById('rain-container');
    
    // 下雨效果相关变量
    let rainInterval = null;
    let raindrops = [];
    const maxRaindrops = 100; // 最大雨滴数量

    // 歌曲数据结构
    let playlist = [];
    
    // 扫描音乐目录并生成播放列表
    const scanMusicDirectory = () => {
      // 在实际环境中，我们需要一个后端API来获取目录中的文件列表
      // 由于这是前端应用，我们需要预定义歌曲列表或者使用静态配置
      // 这里我们使用一个示例列表，用户可以根据需要修改
      const musicFiles = [
        '时落之雨 - Delos.mp3'
        // 用户可以在这里添加更多歌曲文件
      ];
      
      console.log('扫描到的音乐文件:', musicFiles);
      
      playlist = musicFiles.map((filename, index) => {
        // 从文件名中提取歌曲标题和艺术家
        let title = filename.replace('.mp3', '');
        let artist = '未知艺术家';
        
        // 尝试解析文件名格式：艺术家 - 标题.mp3
        const match = title.match(/(.+)\s-\s(.+)/);
        if (match) {
          artist = match[1];
          title = match[2];
        }
        
        return {
          id: index + 1,
          title: title,
          artist: artist,
          src: `/music/${filename}`,
          lyricSrc: `/music/${filename.replace('.mp3', '.lrc')}`
        };
      });
      
      console.log('生成的播放列表:', playlist);
      
      // 渲染播放列表
      renderPlaylist();
      
      // 如果有歌曲，加载第一首
      if (playlist.length > 0) {
        loadSong(0);
      }
    };
    
    // 当前播放索引
    let currentSongIndex = 0;
    let currentLyrics = [];
    let isPlaying = false;

    // 默认音量
    audio.volume = 0.5;
    volumeFill.style.width = '50%';

    // 打开/关闭播放器
    const togglePlayer = () => {
      musicPlayer.classList.toggle('active');
      playerOverlay.classList.toggle('active');
      document.body.style.overflow = musicPlayer.classList.contains('active') ? 'hidden' : 'auto';
    };

    // 打开/关闭播放列表
    const togglePlaylist = () => {
      playlistPanel.classList.toggle('active');
    };

    // LRC歌词解析函数
    const parseLRC = (lrcText) => {
      const lyrics = [];
      const lines = lrcText.split('\n');
      const timeRegex = /\[([0-9:.]+)\]/g;

      lines.forEach(line => {
        let match;
        const times = [];
        
        // 提取所有时间标签
        while ((match = timeRegex.exec(line)) !== null) {
          const timeStr = match[1];
          const [minutes, seconds] = timeStr.split(':');
          const [secs, ms] = seconds.split('.');
          const timeInSeconds = parseInt(minutes) * 60 + parseInt(secs) + (parseInt(ms || 0) / 100);
          times.push(timeInSeconds);
        }

        // 提取歌词内容
        const text = line.replace(timeRegex, '').trim();
        
        if (text && times.length > 0) {
          times.forEach(time => {
            lyrics.push({ time, text });
          });
        }
      });

      // 按时间排序
      return lyrics.sort((a, b) => a.time - b.time);
    };

    // 加载歌词
    const loadLyrics = (lyricSrc) => {
      if (!lyricSrc) {
        currentLyrics = [];
        lyricsEl.innerHTML = '<p>暂无歌词</p>';
        return;
      }

      fetch(lyricSrc)
        .then(response => response.text())
        .then(text => {
          currentLyrics = parseLRC(text);
          renderLyrics();
        })
        .catch(error => {
          console.error('加载歌词失败:', error);
          currentLyrics = [];
          lyricsEl.innerHTML = '<p>无法加载歌词</p>';
        });
    };

    // 渲染歌词
    const renderLyrics = () => {
      if (currentLyrics.length === 0) {
        lyricsEl.innerHTML = '<p>暂无歌词</p>';
        return;
      }

      const html = currentLyrics.map((lyric, index) => 
        `<p class="lyric-line" data-index="${index}">${lyric.text}</p>`
      ).join('');
      
      lyricsEl.innerHTML = html;
    };

    // 更新当前播放的歌词
    const updateCurrentLyric = () => {
      if (currentLyrics.length === 0) return;

      const currentTime = audio.currentTime;
      let currentIndex = -1;

      // 找到当前时间对应的歌词索引
      for (let i = 0; i < currentLyrics.length; i++) {
        if (currentLyrics[i].time <= currentTime) {
          currentIndex = i;
        } else {
          break;
        }
      }

      // 更新歌词高亮
      const lyricLines = document.querySelectorAll('.lyric-line');
      lyricLines.forEach((line, index) => {
        line.classList.toggle('active', index === currentIndex);
      });

      // 滚动到当前歌词
      if (currentIndex >= 0 && lyricLines[currentIndex]) {
        const lineTop = lyricLines[currentIndex].offsetTop;
        const containerHeight = lyricsContainer.clientHeight;
        const lineHeight = lyricLines[currentIndex].clientHeight;
        
        lyricsContainer.scrollTop = lineTop - containerHeight / 2 + lineHeight / 2;
      }
    };

    // 播放/暂停功能
    const togglePlay = () => {
      const icon = playBtn.querySelector('.material-symbols-outlined');
      if (audio.paused) {
        audio.play();
        icon.textContent = 'pause';
        playBtn.setAttribute('aria-label', '暂停');
        isPlaying = true;
      } else {
        audio.pause();
        icon.textContent = 'play_arrow';
        playBtn.setAttribute('aria-label', '播放');
        isPlaying = false;
      }
    };

    // 加载并播放指定歌曲
    const loadSong = (index) => {
      const song = playlist[index];
      if (!song) {
        console.error('找不到指定索引的歌曲:', index);
        return;
      }

      console.log('加载歌曲:', song.title, '路径:', song.src);
      
      // 更新当前播放索引
      currentSongIndex = index;

      // 更新音频源
      audio.src = song.src;
      
      // 监听音频加载错误
      audio.onerror = (error) => {
        console.error('音频加载错误:', error);
        console.error('错误代码:', error.target.error.code);
        console.error('错误消息:', error.target.error.message);
      };
      
      // 监听音频加载成功
      audio.oncanplay = () => {
        console.log('音频加载成功:', song.title);
      };
      
      // 更新歌曲信息
      songTitleEl.textContent = song.title;
      songArtistEl.textContent = song.artist;

      // 加载歌词
      loadLyrics(song.lyricSrc);

      // 如果当前正在播放，则播放新歌曲
      if (isPlaying) {
        audio.play();
      }

      // 更新播放列表活跃状态
      updatePlaylistActive(index);
      
      // 更新下雨效果
      updateRainEffect();
    };

    // 播放上一首
    const playPrevious = () => {
      currentSongIndex = (currentSongIndex - 1 + playlist.length) % playlist.length;
      loadSong(currentSongIndex);
    };

    // 播放下一首
    const playNext = () => {
      currentSongIndex = (currentSongIndex + 1) % playlist.length;
      loadSong(currentSongIndex);
    };

    // 更新播放列表活跃状态
    const updatePlaylistActive = (index) => {
      const playlistItems = document.querySelectorAll('.playlist-item');
      playlistItems.forEach((item, i) => {
        item.classList.toggle('active', i === index);
      });
    };

    // 渲染播放列表
    const renderPlaylist = () => {
      if (!playlistContent) return;
      
      const html = playlist.map((song, index) => `
        <div class="playlist-item ${index === currentSongIndex ? 'active' : ''}" data-index="${index}">
          <span class="material-symbols-outlined">music_note</span>
          <div class="playlist-info">
            <div class="playlist-title">${song.title}</div>
            <div class="playlist-artist">${song.artist}</div>
          </div>
          <span class="material-symbols-outlined">play_arrow</span>
        </div>
      `).join('');
      
      playlistContent.innerHTML = html;

      // 添加播放列表点击事件
      const playlistItems = document.querySelectorAll('.playlist-item');
      playlistItems.forEach(item => {
        item.addEventListener('click', () => {
          const index = parseInt(item.dataset.index);
          currentSongIndex = index;
          loadSong(currentSongIndex);
        });
      });
    };

    // 更新进度条
    const updateProgress = () => {
      const progress = (audio.currentTime / audio.duration) * 100;
      progressFill.style.width = `${progress}%`;

      // 更新时间显示
      const currentMinutes = Math.floor(audio.currentTime / 60);
      const currentSeconds = Math.floor(audio.currentTime % 60);
      const totalMinutes = Math.floor(audio.duration / 60);
      const totalSeconds = Math.floor(audio.duration % 60);

      currentTimeEl.textContent = `${currentMinutes}:${currentSeconds.toString().padStart(2, '0')}`;
      totalTimeEl.textContent = `${totalMinutes}:${totalSeconds.toString().padStart(2, '0')}`;

      // 更新歌词
      updateCurrentLyric();
    };

    // 设置进度条位置
    const setProgress = (e) => {
      const width = progressBar.clientWidth;
      const clickX = e.offsetX;
      const duration = audio.duration;
      audio.currentTime = (clickX / width) * duration;
    };

    // 音量控制
    const setVolume = (e) => {
      const width = volumeBar.clientWidth;
      const clickX = e.offsetX;
      audio.volume = clickX / width;
      volumeFill.style.width = `${(clickX / width) * 100}%`;
    };

    // 静音/取消静音
    const toggleMute = () => {
      const icon = volumeBtn.querySelector('.material-symbols-outlined');
      if (audio.muted) {
        audio.muted = false;
        icon.textContent = 'volume_up';
        volumeBtn.setAttribute('aria-label', '静音');
        volumeFill.style.opacity = '1';
      } else {
        audio.muted = true;
        icon.textContent = 'volume_off';
        volumeBtn.setAttribute('aria-label', '取消静音');
        volumeFill.style.opacity = '0.5';
      }
    };

    // 事件监听
    musicControlBtn.addEventListener('click', togglePlayer);
    closeBtn.addEventListener('click', togglePlayer);
    playerOverlay.addEventListener('click', togglePlayer);
    playBtn.addEventListener('click', togglePlay);
    audio.addEventListener('timeupdate', updateProgress);
    audio.addEventListener('ended', playNext); // 歌曲结束时播放下一首
    progressBar.addEventListener('click', setProgress);
    volumeBtn.addEventListener('click', toggleMute);
    volumeBar.addEventListener('click', setVolume);
    playlistBtn.addEventListener('click', togglePlaylist);
    closePlaylistBtn.addEventListener('click', togglePlaylist);
    prevBtn.addEventListener('click', playPrevious);
    nextBtn.addEventListener('click', playNext);

    // 初始化音频时长显示
    audio.addEventListener('loadedmetadata', () => {
      const totalMinutes = Math.floor(audio.duration / 60);
      const totalSeconds = Math.floor(audio.duration % 60);
      totalTimeEl.textContent = `${totalMinutes}:${totalSeconds.toString().padStart(2, '0')}`;
    });

    // 生成雨滴的函数
    const createRaindrop = () => {
      const raindrop = document.createElement('div');
      raindrop.className = 'raindrop';
      
      // 随机位置
      raindrop.style.left = `${Math.random() * 100}vw`;
      
      // 随机大小
      const size = Math.random() * 2 + 1;
      raindrop.style.width = `${size}px`;
      raindrop.style.height = `${size * 5}px`;
      
      // 随机速度
      const duration = Math.random() * 2 + 1;
      raindrop.style.animationDuration = `${duration}s`;
      
      // 随机不透明度
      raindrop.style.opacity = Math.random() * 0.5 + 0.3;
      
      rainContainer.appendChild(raindrop);
      raindrops.push(raindrop);
      
      // 动画结束后移除雨滴
      raindrop.addEventListener('animationend', () => {
        raindrop.remove();
        raindrops = raindrops.filter(drop => drop !== raindrop);
      });
    };
    
    // 开始下雨效果
    const startRain = () => {
      if (rainInterval) return;
      
      rainContainer.classList.add('active');
      
      // 定期生成雨滴
      rainInterval = setInterval(() => {
        if (raindrops.length < maxRaindrops) {
          createRaindrop();
        }
      }, 50);
    };
    
    // 停止下雨效果
    const stopRain = () => {
      if (rainInterval) {
        clearInterval(rainInterval);
        rainInterval = null;
      }
      
      // 移除所有雨滴
      raindrops.forEach(raindrop => raindrop.remove());
      raindrops = [];
      
      rainContainer.classList.remove('active');
    };
    
    // 根据当前播放的歌曲更新下雨效果
    const updateRainEffect = () => {
      if (playlist.length === 0) return;
      
      const currentSong = playlist[currentSongIndex];
      if (currentSong && currentSong.title.includes('时落之雨')) {
        startRain();
      } else {
        stopRain();
      }
    };
    
    // 初始化播放列表
    scanMusicDirectory();
  });
</script>

<style>
  /* 音乐播放器样式 */
  .music-player-container {
    position: relative;
    z-index: 999;
  }

  /* 固定定位的音乐控制按钮 */
  .music-control-btn {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: var(--md3-primary);
    border: none;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    transition: var(--transition);
    z-index: 1000;
  }

  .music-control-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
  }

  .music-control-btn .material-symbols-outlined {
    font-size: 2rem;
  }

  /* 音乐播放器界面 */
  .music-player {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 90vw;
    max-width: 1000px;
    height: 70vh;
    max-height: 600px;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--transition);
    z-index: 1001;
  }

  .music-player.active {
    transform: translateY(0);
    opacity: 1;
  }

  /* 播放器头部 */
  .player-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .player-header .material-symbols-outlined {
    font-size: 1.5rem;
  }

  .playlist-btn, .close-btn {
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: var(--border-radius-md);
    transition: var(--transition);
  }

  .playlist-btn:hover, .close-btn:hover {
    background-color: var(--bg-tertiary);
  }

  /* 播放器主体内容 */
  .player-content {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* 左侧播放控制区域 */
  .player-left {
    flex: 1;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* 歌曲信息 */
  .song-info {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .album-cover {
    width: 120px;
    height: 120px;
    background-color: var(--bg-tertiary);
    border-radius: var(--border-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: var(--md3-primary);
  }

  .song-details {
    flex: 1;
  }

  .song-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }

  .song-artist {
    color: var(--text-secondary);
    margin: 0;
  }

  /* 播放控制按钮 */
  .play-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .control-btn {
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 1rem;
    border-radius: 50%;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .control-btn:hover {
    background-color: var(--bg-tertiary);
  }

  .control-btn .material-symbols-outlined {
    font-size: 1.5rem;
  }

  .play-btn {
    background-color: var(--md3-primary);
    color: var(--md3-on-primary);
    width: 60px;
    height: 60px;
  }

  .play-btn:hover {
    background-color: var(--md3-primary);
    transform: scale(1.1);
  }

  /* 进度条 */
  .progress-container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .time-display {
    font-size: 0.9rem;
    color: var(--text-secondary);
    min-width: 45px;
    text-align: center;
  }

  .progress-bar {
    flex: 1;
    height: 4px;
    background-color: var(--bg-tertiary);
    border-radius: 2px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background-color: var(--md3-primary);
    border-radius: 2px;

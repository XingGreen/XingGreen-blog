---
import { sidebarLayoutConfig } from '../config';

interface SocialLink {
  name: string;
  url: string;
  icon: string;
}

interface Props {
  avatar?: string;
  name?: string;
  quote?: string;
  socialLinks?: SocialLink[];
}

interface ProfileConfig {
  avatar?: string;
  name?: string;
  bio?: string;
  socialLinks?: SocialLink[];
}

// 从配置中获取个人资料信息
const leftSidebarConfig = sidebarLayoutConfig.find(sidebar => sidebar.position === 'left');
const profileConfig = leftSidebarConfig?.components.find(component => component.name === 'Profile')?.config as ProfileConfig || {};

const {
  avatar = profileConfig.avatar || 'http://q.qlogo.cn/headimg_dl?dst_uin=483165474&spec=640&img_type=jpg',
  name = profileConfig.name || 'XingGreen',
  quote = profileConfig.bio || '人生如梦，不期而遇',
  socialLinks = profileConfig.socialLinks || []
} = Astro.props as Props;
---

<div class="author-profile">
  <div class="profile-card">
    <div class="avatar-container">
      <img src={avatar} alt={`${name}的头像`} class="author-avatar" loading="lazy" width="150" height="150" />
    </div>
    
    <h2 class="author-name">{name}</h2>
    <p class="author-quote">{quote}</p>
    
    <div class="social-links">
      {socialLinks.map((link) => (
        <a 
          href={link.url} 
          class="social-link" 
          aria-label={`访问我的${link.name}主页`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="material-symbols-outlined">{link.icon}</span>
          <span>{link.name}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
.author-profile {
  margin-bottom: 2rem;
}

.profile-card {
  background: var(--md3-surface);
  border: 2px solid var(--accent-primary);
  border-radius: var(--border-radius-lg);
  padding: 2rem;
  text-align: center;
  backdrop-filter: blur(10px);
  box-shadow: var(--shadow-concave-convex);
  transition: var(--transition);
}

.profile-card:hover {
  box-shadow: var(--shadow-concave-convex-hover);
  transform: translateY(-2px);
}

.avatar-container {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto 1.5rem;
  border: 4px solid var(--accent-primary);
  box-shadow: var(--btn-gummy-shadow);
  background: var(--accent-gradient);
  padding: 4px;
}

.author-avatar {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  background: var(--bg-primary);
}

.author-name {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  font-family: var(--font-family-title);
  background: var(--accent-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.author-quote {
  font-size: 0.95rem;
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
  font-style: italic;
  font-family: var(--font-family-dialog);
  background: var(--bg-tertiary);
  padding: 1rem;
  border-radius: var(--border-radius-md);
  border-left: 3px solid var(--accent-primary);
}

.social-links {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
  flex-wrap: wrap;
}

.social-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: var(--bg-primary);
  border: 2px solid var(--accent-primary);
  border-radius: var(--btn-gummy-radius);
  color: var(--accent-primary);
  text-decoration: none;
  transition: var(--transition);
  font-size: 0.85rem;
  font-family: var(--font-family-base);
  box-shadow: var(--btn-gummy-shadow);
}

.social-link:hover {
  background: var(--accent-gradient);
  color: var(--bg-primary);
  transform: translateY(var(--btn-gummy-transform-pressed));
  box-shadow: var(--btn-gummy-shadow-pressed);
  border-color: transparent;
}

.social-link span.material-symbols-outlined {
  font-size: 1.2rem;
}
</style>
---
import { getCollection } from 'astro:content';

interface Props {
  config: {
    title?: string;
    maxPosts?: number;
  };
}

const { config } = Astro.props;
const defaultConfig = {
  title: '最新文章',
  maxPosts: 5,
  ...config,
};

// 获取所有博客文章
const posts = await getCollection('blog');

// 按日期排序并限制数量
const recentPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, defaultConfig.maxPosts);

// 格式化日期
const formatDate = (date: Date): string => {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);
};
---

<div class="recent-posts-card glass">
  <h3 class="card-title">{defaultConfig.title}</h3>
  
  {recentPosts.length > 0 ? (
    <ul class="recent-posts-list">
      {recentPosts.map((post) => (
        <li class="recent-post-item">
          <a 
            href={`/blog/${post.slug}`} 
            class="recent-post-link"
            aria-label={`阅读文章: ${post.data.title}`}
          >
            <div class="recent-post-content">
              <h4 class="recent-post-title">{post.data.title}</h4>
              <p class="recent-post-meta">{formatDate(post.data.date)}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty-message">暂无文章</p>
  )}
</div>

<style scoped>
.recent-posts-card {
  padding: 1.5rem;
}

.card-title {
  font-size: 1.25rem;
  margin: 0 0 1rem 0;
  color: var(--md3-on-surface);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.recent-posts-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.recent-post-item {
  transition: all 0.2s ease;
}

.recent-post-link {
  display: block;
  color: var(--md3-on-surface);
  text-decoration: none;
  transition: all 0.2s ease;
}

.recent-post-link:hover .recent-post-title {
  color: var(--md3-primary);
}

.recent-post-content {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.recent-post-title {
  font-size: 1rem;
  margin: 0;
  line-height: 1.4;
  transition: color 0.2s ease;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recent-post-meta {
  font-size: 0.875rem;
  color: var(--md3-on-surface-variant);
  margin: 0;
}

.empty-message {
  color: var(--md3-on-surface-variant);
  text-align: center;
  padding: 1rem 0;
  margin: 0;
}
</style>

---
import { getCollection } from 'astro:content';

interface Props {
  config: {
    title?: string;
  };
}

const { config } = Astro.props;
const defaultConfig = {
  title: '分类',
  ...config,
};

// 获取所有博客文章
const posts = await getCollection('blog');

// 统计分类
const categories = posts.reduce((acc, post) => {
  const category = post.data.category;
  acc[category] = (acc[category] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

// 转换为数组并排序
const categoryList = Object.entries(categories)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);
---

<div class="category-list-card glass">
  <h3 class="card-title">{defaultConfig.title}</h3>
  
  {categoryList.length > 0 ? (
    <ul class="category-list">
      {categoryList.map((category) => (
        <li class="category-item">
          <a 
            href={`/categories/${category.name.toLowerCase()}`} 
            class="category-link"
            aria-label={`查看${category.name}分类下的文章 (${category.count}篇)`}
          >
            <span class="category-name">{category.name}</span>
            <span class="category-count">{category.count}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty-message">暂无分类</p>
  )}
</div>

<style scoped>
.category-list-card {
  padding: 1.5rem;
}

.card-title {
  font-size: 1.25rem;
  margin: 0 0 1rem 0;
  color: var(--md3-on-surface);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.category-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.category-item {
  transition: all 0.2s ease;
}

.category-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem;
  color: var(--md3-on-surface-variant);
  text-decoration: none;
  border-radius: 6px;
  transition: all 0.2s ease;
}

.category-link:hover {
  background-color: var(--md3-secondary-container);
  color: var(--md3-on-secondary-container);
  text-decoration: none;
}

.category-count {
  font-size: 0.875rem;
  color: var(--md3-primary);
  background-color: var(--md3-primary-container);
  padding: 0.125rem 0.5rem;
  border-radius: 12px;
  font-weight: 500;
}

.empty-message {
  color: var(--md3-on-surface-variant);
  text-align: center;
  padding: 1rem 0;
  margin: 0;
}
</style>

---
import { getCollection } from 'astro:content';

interface Props {
  config: {
    title?: string;
    maxTags?: number;
  };
}

const { config } = Astro.props;
const defaultConfig = {
  title: '标签云',
  maxTags: 20,
  ...config,
};

// 获取所有博客文章
const posts = await getCollection('blog');

// 统计标签
const tags = posts.reduce((acc, post) => {
  post.data.tags.forEach((tag: string) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

// 转换为数组并排序
let tagList = Object.entries(tags)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

// 限制标签数量
if (defaultConfig.maxTags > 0) {
  tagList = tagList.slice(0, defaultConfig.maxTags);
}

// 计算标签大小范围 (12px - 20px)
const minCount = Math.min(...tagList.map(tag => tag.count));
const maxCount = Math.max(...tagList.map(tag => tag.count));
const sizeRange = { min: 12, max: 20 };

// 计算标签大小
const getTagSize = (count: number): number => {
  if (minCount === maxCount) return sizeRange.min;
  return Math.round(
    sizeRange.min + ((count - minCount) / (maxCount - minCount)) * (sizeRange.max - sizeRange.min)
  );
};
---

<div class="tag-cloud-card glass">
  <h3 class="card-title">{defaultConfig.title}</h3>
  
  {tagList.length > 0 ? (
    <div class="tag-cloud">
      {tagList.map((tag) => {
        const size = getTagSize(tag.count);
        return (
          <a 
            href={`/tags/${tag.name.toLowerCase()}`} 
            class="tag"
            style={{ fontSize: `${size}px` }}
            aria-label={`查看${tag.name}标签下的文章 (${tag.count}篇)`}
          >
            {tag.name}
          </a>
        );
      })}
    </div>
  ) : (
    <p class="empty-message">暂无标签</p>
  )}
</div>

<style scoped>
.tag-cloud-card {
  padding: 1.5rem;
}

.card-title {
  font-size: 1.25rem;
  margin: 0 0 1rem 0;
  color: var(--md3-on-surface);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: center;
}

.tag {
  color: var(--md3-primary);
  text-decoration: none;
  padding: 0.375rem 0.75rem;
  border-radius: 20px;
  background-color: var(--md3-primary-container);
  transition: all 0.2s ease;
  font-weight: 500;
  line-height: 1.5;
}

.tag:hover {
  background-color: var(--md3-primary);
  color: var(--md3-on-primary);
  transform: translateY(-2px);
  text-decoration: none;
}

.empty-message {
  color: var(--md3-on-surface-variant);
  text-align: center;
  padding: 1rem 0;
  margin: 0;
}
</style>

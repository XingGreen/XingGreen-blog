---
import type { BlogPost } from '../data/blogPosts';

interface Props {
  posts: BlogPost[];
  announcement?: string;
}

const { 
  posts,
  announcement = '欢迎访问我的博客！这里分享我的学习和生活点滴。'
} = Astro.props;

// 提取分类
const categories = Array.from(new Set(posts.map(post => post.category)));

// 提取标签并统计数量
const tagCounts = posts.reduce((acc, post) => {
  post.tags.forEach(tag => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<div class="sidebar-components">
  <!-- 公告组件 -->
  <div class="sidebar-card announcement">
    <h3 class="sidebar-title">
      <span class="material-symbols-outlined">announcement</span>
      公告
    </h3>
    <p class="announcement-text">{announcement}</p>
  </div>

  <!-- 分类组件 -->
  <div class="sidebar-card categories">
    <h3 class="sidebar-title">
      <span class="material-symbols-outlined">category</span>
      分类
    </h3>
    <ul class="category-list">
      {categories.map(category => (
        <li class="category-item">
          <a href={`/blog?category=${encodeURIComponent(category)}`} class="category-link">
            {category}
            <span class="category-count">
              {posts.filter(post => post.category === category).length}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- 标签组件 -->
  <div class="sidebar-card tags">
    <h3 class="sidebar-title">
      <span class="material-symbols-outlined">sell</span>
      标签
    </h3>
    <div class="tag-cloud">
      {tags.map(([tag, count]) => (
        <a 
          href={`/blog?tag=${encodeURIComponent(tag)}`} 
          class="tag"
          style={`font-size: ${Math.min(1 + count * 0.1, 1.5)}rem`}
        >
          {tag} <span class="tag-count">({count})</span>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
.sidebar-components {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.sidebar-card {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  padding: 1.5rem;
  backdrop-filter: blur(10px);
  box-shadow: 0 4px 6px var(--shadow);
}

.sidebar-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 1rem;
  color: var(--text-primary);
}

.sidebar-title .material-symbols-outlined {
  font-size: 1.3rem;
  color: var(--accent-color);
}

/* 公告组件样式 */
.announcement-text {
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--text-secondary);
  padding: 0.5rem;
  background: rgba(152, 251, 152, 0.1);
  border-left: 3px solid var(--accent-color);
  border-radius: 4px;
}

/* 分类组件样式 */
.category-list {
  list-style: none;
}

.category-item {
  margin-bottom: 0.5rem;
}

.category-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem;
  border-radius: 8px;
  color: var(--text-primary);
  text-decoration: none;
  transition: all 0.3s ease;
  background: rgba(255, 255, 255, 0.05);
}

.category-link:hover {
  background: var(--accent-color);
  color: white;
  transform: translateX(5px);
}

.category-count {
  font-size: 0.8rem;
  background: rgba(255, 255, 255, 0.2);
  padding: 0.2rem 0.5rem;
  border-radius: 10px;
}

.category-link:hover .category-count {
  background: rgba(255, 255, 255, 0.3);
}

/* 标签组件样式 */
.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.5rem 0.8rem;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-primary);
  text-decoration: none;
  font-size: 0.9rem;
  transition: all 0.3s ease;
}

.tag:hover {
  background: var(--accent-color);
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 4px 8px var(--shadow);
}

.tag-count {
  font-size: 0.75rem;
  opacity: 0.8;
}

.tag:hover .tag-count {
  opacity: 1;
}
</style>
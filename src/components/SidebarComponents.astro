---
import type { BlogPost } from '../data/blogPosts';

interface Props {
  posts: BlogPost[];
  announcement?: string;
}

const { 
  posts,
  announcement = '欢迎访问我的博客！这里分享我的学习和生活点滴。'
} = Astro.props;

// 提取分类
const categories = Array.from(new Set(posts.map(post => post.category)));

// 提取标签并统计数量
const tagCounts = posts.reduce((acc, post) => {
  post.tags.forEach(tag => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<div class="sidebar-components">
  <!-- 公告组件 -->
  <div class="sidebar-card announcement glass">
    <h3 class="sidebar-title">
      <span class="material-symbols-outlined">announcement</span>
      公告
    </h3>
    <p class="announcement-text">{announcement}</p>
  </div>

  <!-- 分类组件 -->
  <div class="sidebar-card categories glass">
    <h3 class="sidebar-title">
      <span class="material-symbols-outlined">category</span>
      分类
    </h3>
    <ul class="category-list">
      {categories.map(category => (
        <li class="category-item">
          <a href={`/blog?category=${encodeURIComponent(category)}`} class="category-link">
            {category}
            <span class="category-count">
              {posts.filter(post => post.category === category).length}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- 标签组件 -->
  <div class="sidebar-card tags glass">
    <h3 class="sidebar-title">
      <span class="material-symbols-outlined">sell</span>
      标签
    </h3>
    <div class="tag-cloud">
      {tags.map(([tag, count]) => (
        <a 
          href={`/blog?tag=${encodeURIComponent(tag)}`} 
          class="tag"
          style={`font-size: ${Math.min(1 + count * 0.1, 1.5)}rem`}
        >
          {tag} <span class="tag-count">({count})</span>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
.sidebar-components {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.sidebar-card {
  background: var(--md3-surface);
  border: 2px solid var(--accent-primary);
  border-radius: var(--border-radius-lg);
  padding: 1.5rem;
  box-shadow: var(--shadow-concave-convex);
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

/* 玻璃态侧边栏卡片样式调整 */
.sidebar-card.glass {
  background: transparent;
  border: 0.08px solid rgba(255, 255, 255, 0.8);
  box-shadow: var(--shadow-sm);
}



.sidebar-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: var(--accent-gradient);
}

.sidebar-card:hover {
  box-shadow: var(--shadow-concave-convex-hover);
  transform: translateY(-3px);
}

.sidebar-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 1rem;
  color: var(--md3-on-surface);
  font-family: var(--font-family-title);
  background: var(--accent-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.sidebar-title .material-symbols-outlined {
  font-size: 1.3rem;
  color: var(--accent-primary);
  text-shadow: 0 2px 4px rgba(72, 187, 120, 0.3);
}

/* 公告组件样式 */
.announcement-text {
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--md3-on-surface-variant);
  padding: 1rem;
  background: var(--bg-tertiary);
  border-left: 3px solid var(--accent-primary);
  border-radius: var(--border-radius-md);
  font-family: var(--font-family-dialog);
  box-shadow: var(--neumorph-shadow-inner-sm);
}

/* 分类组件样式 */
.category-list {
  list-style: none;
}

.category-item {
  margin-bottom: 0.5rem;
}

.category-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 1rem;
  border-radius: var(--btn-gummy-radius);
  color: var(--text-primary);
  text-decoration: none;
  transition: var(--transition);
  background: var(--bg-primary);
  border: 2px solid var(--border-color);
  box-shadow: var(--neumorph-shadow-sm);
  font-family: var(--font-family-base);
}

.category-link:hover {
  background: var(--accent-gradient);
  color: var(--bg-primary);
  transform: translateX(5px) translateY(-1px);
  border-color: var(--accent-primary);
  box-shadow: var(--btn-gummy-shadow);
}

.category-count {
  font-size: 0.8rem;
  background: var(--bg-secondary);
  padding: 0.2rem 0.6rem;
  border-radius: var(--border-radius-full);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}

.category-link:hover .category-count {
  background: var(--bg-primary);
  color: var(--accent-primary);
  border-color: var(--accent-primary);
}

/* 标签组件样式 */
.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.5rem 1rem;
  border-radius: var(--btn-gummy-radius);
  background: var(--bg-primary);
  color: var(--accent-primary);
  text-decoration: none;
  font-size: 0.9rem;
  transition: var(--transition);
  border: 2px solid var(--accent-primary);
  box-shadow: var(--btn-gummy-shadow);
  font-family: var(--font-family-base);
}

.tag:hover {
  background: var(--accent-gradient);
  color: var(--bg-primary);
  transform: translateY(-3px);
  box-shadow: var(--btn-gummy-shadow-pressed);
}

.tag-count {
  font-size: 0.75rem;
  opacity: 0.8;
  color: var(--text-secondary);
}

.tag:hover .tag-count {
  opacity: 1;
  color: var(--bg-primary);
}
</style>
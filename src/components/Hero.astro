---
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  ctaText?: string;
  ctaLink?: string;
}

const { title, subtitle, image, ctaText, ctaLink } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <!-- 英雄区域背景图片 -->
  <div class="hero-background">
  </div>
  
  <div class="hero-content">
    <h1 id="hero-title" class="hero-title">
      {title}
    </h1>
    
    {subtitle && (
      <p class="hero-subtitle">
        {subtitle}
      </p>
    )}
    
    <!-- 行动召唤按钮 -->
    {ctaText && ctaLink && (
      <div class="hero-cta">
        <a href={ctaLink} class="btn btn-primary hero-btn" aria-label={ctaText}>
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          {ctaText}
        </a>
      </div>
    )}
  </div>
  
  <!-- 装饰元素 -->
  <div class="hero-decor hero-decor-1"></div>
  <div class="hero-decor hero-decor-2"></div>
  <div class="hero-decor hero-decor-3"></div>
  <div class="hero-decor hero-decor-4"></div>
</section>

<style>
  /* 英雄区域容器 */
  .hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 2rem;
    overflow: hidden;
    border-radius: var(--border-radius-xl);
    margin-bottom: 3rem;
  }
  
  /* 英雄区域背景 */
  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  
  .hero-background-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg, 
      rgba(102, 126, 234, 0.8) 0%, 
      rgba(118, 75, 162, 0.8) 100%
    );
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  
  /* 英雄区域内容 */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
  }
  
  /* 英雄区域标题 */
  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: white;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
    letter-spacing: -0.03em;
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  
  /* 英雄区域副标题 */
  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2.5rem;
    line-height: 1.6;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.2s both;
  }
  
  /* 行动召唤按钮 */
  .hero-cta {
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.4s both;
  }
  
  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    font-size: 1.125rem;
    font-weight: 600;
    border-radius: var(--border-radius-lg);
    background: white;
    color: var(--accent-primary);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }
  
  .hero-btn:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
    text-decoration: none;
  }
  
  /* 装饰元素 */
  .hero-decor {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(30px);
    opacity: 0.3;
    animation: float 6s ease-in-out infinite;
    z-index: 1;
  }
  
  .hero-decor-1 {
    top: 20%;
    left: 10%;
    width: 200px;
    height: 200px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    animation-delay: 0s;
  }
  
  .hero-decor-2 {
    bottom: 25%;
    right: 15%;
    width: 150px;
    height: 150px;
    background: linear-gradient(135deg, var(--md3-tertiary), var(--accent-primary));
    animation-delay: 2s;
  }
  
  .hero-decor-3 {
    top: 60%;
    left: 20%;
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, var(--accent-secondary), var(--md3-tertiary));
    animation-delay: 4s;
  }
  
  .hero-decor-4 {
    top: 15%;
    right: 20%;
    width: 120px;
    height: 120px;
    background: linear-gradient(135deg, var(--md3-tertiary), var(--accent-primary));
    animation-delay: 1s;
  }
  
  /* 动画效果 */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes float {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(180deg);
    }
  }
  
  /* 响应式设计 */
  @media (max-width: 768px) {
    .hero {
      min-height: 60vh;
      padding: 3rem 1.5rem;
    }
    
    .hero-title {
      font-size: clamp(2rem, 8vw, 3.5rem);
      margin-bottom: 1rem;
    }
    
    .hero-subtitle {
      font-size: 1.125rem;
      margin-bottom: 2rem;
    }
    
    .hero-btn {
      padding: 0.875rem 1.75rem;
      font-size: 1rem;
    }
    
    .hero-decor {
      filter: blur(20px);
      opacity: 0.2;
    }
    
    .hero-decor-1 {
      width: 150px;
      height: 150px;
    }
    
    .hero-decor-2 {
      width: 100px;
      height: 100px;
    }
    
    .hero-decor-3 {
      width: 80px;
      height: 80px;
    }
    
    .hero-decor-4 {
      width: 100px;
      height: 100px;
    }
  }
  
  @media (max-width: 480px) {
    .hero {
      min-height: 50vh;
      padding: 2rem 1rem;
    }
    
    .hero-title {
      font-size: clamp(1.75rem, 10vw, 2.5rem);
    }
    
    .hero-subtitle {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }
    
    .hero-btn {
      padding: 0.75rem 1.5rem;
      font-size: 0.9rem;
      width: 100%;
      justify-content: center;
    }
  }
</style>
---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  category: string;
  tags: string[];
  author: string;
  slug: string;
  image?: string;
  readTime?: number;
  comments?: number;
}

const { title, excerpt, date, category, tags, author, slug } = Astro.props;

// 格式化日期
const formattedDate = new Date(date).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<div class="card blog-card">
  <div class="card-content">
    <div class="card-meta">
      <div class="card-date">
        <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
        <span>{formattedDate}</span>
      </div>
    </div>
    
    <h3 class="card-title">
      <a href={`/blog/${slug}`} aria-label={`阅读文章：${title}`}>
        {title}
      </a>
    </h3>
    
    <p class="card-excerpt">
      {excerpt}
    </p>
    
    <div class="card-footer">
      <div class="card-author">
        <span class="material-symbols-outlined" aria-hidden="true">person</span>
        <span>{author}</span>
      </div>
      
      <div class="card-tags">
        {tags.map((tag) => (
          <a 
            href={`/tags/${tag.toLowerCase()}`} 
            class="tag"
            aria-label={`查看标签：${tag} 的文章`}>
            {tag}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* 卡片图片样式 */
  .card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0;
    background: var(--gradient-primary);
  }
  
  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .blog-card:hover .card-image {
    transform: scale(1.05);
  }
  
  .card-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.3));
    pointer-events: none;
  }
  
  /* 分类标签样式 */
  .card-category-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(255, 255, 255, 0.9);
    color: var(--text-primary);
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  
  [data-theme="dark"] .card-category-badge {
    background: rgba(15, 23, 42, 0.9);
    color: var(--text-primary);
  }
  
  .card-category-badge .material-symbols-outlined {
    font-size: 1rem;
  }
  
  /* 卡片元数据样式 */
  .card-meta {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--text-tertiary);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
    flex-wrap: wrap;
  }
  
  .card-read-time,
  .card-comments {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .card-read-time .material-symbols-outlined,
  .card-comments .material-symbols-outlined {
    font-size: 1rem;
  }
  
  /* 卡片标题样式 */
  .card-title {
    font-size: 1.75rem;
    margin: 1.5rem 0 1rem;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  
  .card-title a {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .blog-card:hover .card-title a {
    transform: translateX(8px);
    text-decoration: underline;
    text-decoration-color: var(--accent-primary);
  }
  
  /* 卡片摘要样式 */
  .card-excerpt {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    font-size: 1rem;
  }
  
  /* 卡片页脚样式 */
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  /* 标签样式优化 */
  .card-tags {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  
  .tag {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    padding: 0.4rem 0.9rem;
    border-radius: var(--border-radius-full);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-flex;
    align-items: center;
  }
  
  .tag:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(5, 150, 105, 0.4);
    text-decoration: none;
  }
  
  /* 卡片悬停效果优化 */
  .blog-card {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    border-radius: var(--border-radius-lg);
  }
  
  .blog-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: var(--shadow-xl);
  }
  
  /* 响应式设计 */
  @media (max-width: 768px) {
    .card-title {
      font-size: 1.5rem;
    }
    
    .card-meta {
      gap: 1rem;
    }
    
    .card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    
    .card-tags {
      width: 100%;
    }
  }
</style>
---
// 搜索组件
interface Props {
  placeholder?: string;
}

const { placeholder = "搜索文章..." } = Astro.props;
---

<div class="search-container">
  <div class="search-input-wrapper">
    <span class="material-symbols-outlined search-icon">search</span>
    <input 
      type="text" 
      class="search-input" 
      placeholder={placeholder}
      aria-label={placeholder}
      id="search-input"
    />
  </div>
  <div class="search-results" id="search-results"></div>
</div>

<style>
.search-container {
  position: relative;
  width: 100%;
  max-width: 400px;
  margin: 0 auto;
}

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 12px;
  color: var(--text-secondary);
  font-size: 1.25rem;
  pointer-events: none;
}

.search-input {
  width: 100%;
  padding: 12px 16px 12px 44px;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  background: var(--md3-surface);
  color: var(--text-primary);
  font-size: 1rem;
  font-family: inherit;
  transition: all 0.3s cubic-bezier(.4,0,.2,1);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.search-input:focus {
  outline: none;
  border-color: var(--md3-primary);
  box-shadow: 0 0 0 3px var(--md3-primary-container);
  transform: translateY(-1px);
}

.search-input::placeholder {
  color: var(--text-secondary);
}

.search-results {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  margin-top: 8px;
  max-height: 400px;
  overflow-y: auto;
  background: var(--md3-surface);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  box-shadow: var(--shadow-md);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 100;
  display: none;
}

.search-results.show {
  display: block;
}

.search-result-item {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-color);
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.search-result-item:last-child {
  border-bottom: none;
  border-radius: 0 0 8px 8px;
}

.search-result-item:hover {
  background-color: var(--bg-tertiary);
}

.search-result-title {
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4px;
  font-size: 0.95rem;
}

.search-result-excerpt {
  color: var(--text-secondary);
  font-size: 0.85rem;
  line-height: 1.5;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.search-result-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 6px;
  font-size: 0.75rem;
  color: var(--text-secondary);
}

.search-result-category {
  background-color: var(--md3-surface-variant);
  padding: 2px 8px;
  border-radius: 12px;
}

/* 滚动条样式 */
.search-results::-webkit-scrollbar {
  width: 6px;
}

.search-results::-webkit-scrollbar-track {
  background: var(--bg-tertiary);
  border-radius: 3px;
}

.search-results::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 3px;
}

.search-results::-webkit-scrollbar-thumb:hover {
  background: var(--text-tertiary);
}

/* 响应式设计 */
@media (max-width: 768px) {
  .search-container {
    max-width: 100%;
  }
  
  .search-input {
    padding: 10px 14px 10px 40px;
    font-size: 0.9rem;
  }
}
</style>

<script>
import Fuse from 'fuse.js';

// 搜索配置
const searchConfig = {
  keys: ['title', 'excerpt', 'tags', 'category'],
  threshold: 0.3,
  includeMatches: true,
  minMatchCharLength: 2
};

// 获取搜索元素
const searchInput = document.getElementById('search-input');
const searchResults = document.getElementById('search-results');

// 定义类型
interface BlogPost {
  title: string;
  excerpt: string;
  date: string;
  category: string;
  tags: string[];
  author: string;
  slug: string;
}

// 与Fuse.js返回类型匹配
interface FuseResult {
  item: BlogPost;
  matches?: ReadonlyArray<{
    indices: [number, number][];
    key: string;
    value: string;
  }>;
}

// 扩展Window接口
declare global {
  interface Window {
    blogPosts?: BlogPost[];
  }
}

// 搜索功能
const performSearch = (query: string, posts: BlogPost[]) => {
  if (!query.trim() || !searchResults) {
    searchResults?.classList.remove('show');
    return;
  }
  
  const fuse = new Fuse(posts, searchConfig);
  const results = fuse.search(query);
  
  // 转换为我们定义的类型
  renderSearchResults(results as unknown as FuseResult[]);
};

// 渲染搜索结果
const renderSearchResults = (results: FuseResult[]) => {
  if (!searchResults) return;
  
  if (results.length === 0) {
    searchResults.innerHTML = `
      <div class="search-result-item">
        <div class="search-result-title">未找到相关文章</div>
        <div class="search-result-excerpt">请尝试其他搜索关键词</div>
      </div>
    `;
    searchResults.classList.add('show');
    return;
  }
  
  const resultsHTML = results.map(result => {
    const post = result.item;
    return `
      <div class="search-result-item" data-slug="${post.slug}">
        <div class="search-result-title">${post.title}</div>
        <div class="search-result-excerpt">${post.excerpt}</div>
        <div class="search-result-meta">
          <span class="search-result-category">${post.category}</span>
          <span class="search-result-date">${post.date}</span>
        </div>
      </div>
    `;
  }).join('');
  
  searchResults.innerHTML = resultsHTML;
  searchResults.classList.add('show');
  
  // 添加结果点击事件
  const resultItems = searchResults.querySelectorAll('.search-result-item');
  resultItems.forEach(item => {
    item.addEventListener('click', () => {
      const slug = (item as HTMLElement).dataset.slug;
      if (slug) {
        window.location.href = `/blog/${slug}`;
      }
    });
  });
};

// 监听搜索输入
if (searchInput && searchResults) {
  // 获取博客文章数据
  let blogPosts: BlogPost[] = [];
  
  // 从全局变量获取文章数据（需要在页面中定义）
  if (window.blogPosts) {
    blogPosts = window.blogPosts;
  }
  
  // 监听输入事件
  let searchTimeout: NodeJS.Timeout | null = null;
  searchInput.addEventListener('input', (e: Event) => {
    if (searchTimeout) {
      clearTimeout(searchTimeout);
    }
    const query = (e.target as HTMLInputElement).value;
    
    searchTimeout = setTimeout(() => {
      performSearch(query, blogPosts);
    }, 300);
  });
  
  // 点击外部关闭搜索结果
  document.addEventListener('click', (e) => {
    if (e.target instanceof Element && !e.target.closest('.search-container')) {
      searchResults.classList.remove('show');
    }
  });
  
  // 按ESC键关闭搜索结果
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      searchResults.classList.remove('show');
    }
  });
}
</script>
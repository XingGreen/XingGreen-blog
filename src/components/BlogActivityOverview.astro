---
import { getCollection } from 'astro:content';

// 获取所有博客文章
const blogPosts = await getCollection('blog');

// 处理文章数据，生成活动概览数据
const processBlogData = () => {
  // 1. 发布频率统计（按月份）
  const postFrequency = {};
  
  // 2. 分类统计
  const categoryStats = {};
  
  // 3. 标签热度统计
  const tagStats = {};
  
  // 处理每篇文章
  blogPosts.forEach(post => {
    const postDate = new Date(post.data.date);
    
    // 格式化日期为 YYYY-MM 格式
    const dateKey = `${postDate.getFullYear()}-${String(postDate.getMonth() + 1).padStart(2, '0')}`;
    
    // 更新发布频率
    if (!postFrequency[dateKey]) {
      postFrequency[dateKey] = 0;
    }
    postFrequency[dateKey]++;
    
    // 更新分类统计
    const category = post.data.category;
    if (!categoryStats[category]) {
      categoryStats[category] = 0;
    }
    categoryStats[category]++;
    
    // 更新标签统计
    const tags = post.data.tags || [];
    tags.forEach(tag => {
      if (!tagStats[tag]) {
        tagStats[tag] = 0;
      }
      tagStats[tag]++;
    });
  });
  
  // 转换为图表友好的格式
  const chartData = {
    // 发布频率数据
    postFrequency: Object.entries(postFrequency)
      .sort(([dateA], [dateB]) => dateA.localeCompare(dateB))
      .slice(-12) // 只显示最近12个月
      .map(([date, count]) => ({
        date,
        count
      })),
    
    // 分类数据
    categories: Object.entries(categoryStats)
      .sort(([, countA], [, countB]) => countB - countA),
    
    // 标签数据（只显示前10个）
    tags: Object.entries(tagStats)
      .sort(([, countA], [, countB]) => countB - countA)
      .slice(0, 10)
  };
  
  return chartData;
};

const activityData = processBlogData();
---

<div class="sidebar-card activity-overview-card">
  <h3 class="sidebar-title">
    <span class="material-symbols-outlined">insights</span>
    博客活动概览
  </h3>
  
  <!-- 发布频率图表 -->
  <div class="chart-container">
    <h4>最近12个月发布频率</h4>
    <canvas id="post-frequency-chart" class="activity-chart"></canvas>
  </div>
  
  <!-- 分类分布 -->
  <div class="chart-container">
    <h4>分类分布</h4>
    <canvas id="category-chart" class="activity-chart"></canvas>
  </div>
</div>

<!-- 引入 Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script is:inline define:vars={{ activityData }}>
  // 确保DOM加载完成后执行
  document.addEventListener('DOMContentLoaded', () => {
    // 获取CSS变量值
    const getCSSVar = (varName) => {
      return getComputedStyle(document.documentElement).getPropertyValue(varName).trim();
    };
    
    // 设置图表主题颜色
    const accentPrimary = getCSSVar('--accent-primary');
    const accentGradient = getCSSVar('--accent-gradient');
    const bgPrimary = getCSSVar('--bg-primary');
    const bgSecondary = getCSSVar('--bg-secondary');
    const bgTertiary = getCSSVar('--bg-tertiary');
    const textPrimary = getCSSVar('--text-primary');
    const textSecondary = getCSSVar('--text-secondary');
    
    // 提取渐变中的主要颜色
    const parseGradientColor = (gradient) => {
      const match = gradient.match(/rgb\((\d+,\s*\d+,\s*\d+)\)/);
      return match ? match[1] : '72, 187, 120'; // 默认森林绿色
    };
    
    const accentColorRGB = parseGradientColor(accentGradient);
    const accentColor = `rgb(${accentColorRGB})`;
    const accentColorWithOpacity = `rgba(${accentColorRGB}, 0.3)`;
    
    const colors = {
      primary: accentColor,
      secondary: '#9333ea',
      background: bgTertiary,
      text: textPrimary,
      grid: textSecondary,
      doughnutColors: [
        accentColor,
        '#388e3c', // 森林绿色
        '#a78bfa', // 紫色
        '#60a5fa', // 蓝色
        '#34d399', // 绿色
        '#fbbf24', // 黄色
        '#f87171', // 红色
        '#f97316'  // 橙色
      ]
    };
    
    // 1. 创建发布频率图表
    const frequencyCtx = document.getElementById('post-frequency-chart');
    if (frequencyCtx) {
      new Chart(frequencyCtx, {
        type: 'line',
        data: {
          labels: activityData.postFrequency.map(item => item.date),
          datasets: [{
            label: '发布文章数',
            data: activityData.postFrequency.map(item => item.count),
            borderColor: colors.primary,
            backgroundColor: accentColorWithOpacity,
            borderWidth: 3,
            fill: true,
            tension: 0.6,
            pointRadius: 6,
            pointHoverRadius: 8,
            pointBackgroundColor: colors.primary,
            pointBorderColor: bgPrimary,
            pointBorderWidth: 2,
            pointHoverBackgroundColor: bgPrimary,
            pointHoverBorderColor: colors.primary,
            pointHoverBorderWidth: 3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              backgroundColor: bgPrimary,
              titleColor: colors.primary,
              bodyColor: textPrimary,
              borderColor: colors.primary,
              borderWidth: 2,
              borderRadius: 12,
              padding: 12,
              boxPadding: 6,
              usePointStyle: true,
              callbacks: {
                labelPointStyle: function(context) {
                  return { pointStyle: 'circle', rotation: 0 };
                }
              }
            }
          },
          scales: {
            x: {
              grid: {
                color: 'transparent',
                drawBorder: false
              },
              ticks: {
                color: textSecondary,
                font: {
                  family: getCSSVar('--font-family-base')
                }
              }
            },
            y: {
              beginAtZero: true,
              grid: {
                color: bgSecondary,
                drawBorder: false,
                borderDash: [3, 3]
              },
              ticks: {
                color: textSecondary,
                stepSize: 1,
                font: {
                  family: getCSSVar('--font-family-base')
                }
              }
            }
          },
          interaction: {
            mode: 'nearest',
            axis: 'x',
            intersect: false
          },
          elements: {
            line: {
              tension: 0.6
            }
          }
        }
      });
    }
    
    // 2. 创建分类分布图表
    const categoryCtx = document.getElementById('category-chart');
    if (categoryCtx) {
      new Chart(categoryCtx, {
        type: 'doughnut',
        data: {
          labels: activityData.categories.map(([category]) => category),
          datasets: [{
            data: activityData.categories.map(([, count]) => count),
            backgroundColor: colors.doughnutColors,
            borderWidth: 3,
            borderColor: bgPrimary,
            hoverOffset: 10
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                color: textPrimary,
                font: {
                  size: 11,
                  family: getCSSVar('--font-family-base')
                },
                padding: 15,
                usePointStyle: true,
                pointStyle: 'circle'
              }
            },
            tooltip: {
              backgroundColor: bgPrimary,
              titleColor: colors.primary,
              bodyColor: textPrimary,
              borderColor: colors.primary,
              borderWidth: 2,
              borderRadius: 12,
              padding: 12,
              boxPadding: 6,
              callbacks: {
                label: function(context) {
                  const label = context.label || '';
                  const value = context.raw || 0;
                  const total = context.dataset.data.reduce((acc, val) => acc + val, 0);
                  const percentage = Math.round((value / total) * 100);
                  return `${label}: ${value}篇 (${percentage}%)`;
                }
              }
            }
          },
          cutout: '70%'
        }
      });
    }
    

  });
</script>

<style scoped>
.activity-overview-card {
  background: var(--md3-surface);
  border: 2px solid var(--accent-primary);
  border-radius: var(--border-radius-lg);
  padding: 1.5rem;
  box-shadow: var(--shadow-concave-convex);
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.activity-overview-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: var(--accent-gradient);
}

.activity-overview-card:hover {
  box-shadow: var(--shadow-concave-convex-hover);
  transform: translateY(-3px);
}

.chart-container {
  margin-top: 1.5rem;
  background: var(--bg-tertiary);
  border-radius: var(--border-radius-md);
  padding: 1rem;
  box-shadow: var(--neumorph-shadow-inner-sm);
}

.chart-container h4 {
  font-size: 0.95rem;
  font-weight: 600;
  margin-bottom: 1rem;
  font-family: var(--font-family-title);
  background: var(--accent-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.activity-chart {
  height: 180px !important;
  width: 100% !important;
  border-radius: var(--border-radius-sm);
}

/* 响应式调整 */
@media (max-width: 768px) {
  .activity-chart {
    height: 150px !important;
  }
}
</style>
---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const title = '博客归档';
const description = 'XingGreen Blog的所有博客文章';

// 获取所有博客文章并按日期排序
const blogPosts = await getCollection('blog');

// 手动排序博客文章：置顶文章优先，然后按优先级，最后按日期
blogPosts.sort((a, b) => {
  const now = new Date();
  
  // 检查过期时间：如果文章已过期且设置了过期日期，则取消置顶
  const isAPinned = a.data.pin && (!a.data.expiryDate || new Date(a.data.expiryDate) > now);
  const isBPinned = b.data.pin && (!b.data.expiryDate || new Date(b.data.expiryDate) > now);
  
  // 置顶文章优先
  if (isAPinned && !isBPinned) return -1;
  if (!isAPinned && isBPinned) return 1;
  
  // 如果都是置顶文章，按优先级排序（数字越大优先级越高）
  if (isAPinned && isBPinned) {
    if (a.data.priority !== b.data.priority) {
      return b.data.priority - a.data.priority;
    }
  }
  
  // 最后按日期排序
  const dateA = new Date(a.data.date).valueOf();
  const dateB = new Date(b.data.date).valueOf();
  return dateB - dateA;
});
---

<MainLayout title={title} description={description}>
  <section class="blog-archive">
    <div class="container">
      <h2 class="section-title">博客归档</h2>
      <p class="section-description">这里是{title}的所有博客文章，共{blogPosts.length}篇。</p>
      <div id="blog-container" class="blog-grid">
        {blogPosts.map(post => (
          <a href={`/blog/${post.slug}`} class="card ${(post.data.pin && (!post.data.expiryDate || new Date(post.data.expiryDate) > new Date())) ? 'pinned' : ''}" aria-label={`阅读文章：${post.data.title}`}>
            <div class="card-content">
              {post.data.pin && (!post.data.expiryDate || new Date(post.data.expiryDate) > new Date()) && (
                <div class="card-pinned">
                  <span class="material-symbols-outlined">push_pin</span>
                  <span>置顶</span>
                </div>
              )}
              <span class="card-category">{post.data.category}</span>
              <h3 class="card-title">{post.data.title}</h3>
              <p class="card-excerpt">{post.data.excerpt}</p>
              <div class="card-meta">
                <span class="card-date">
                  <span class="material-symbols-outlined">calendar_today</span>
                  {new Date(post.data.date).toLocaleDateString('zh-CN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </span>
                {post.data.tags.length > 0 && (
                  <span class="card-tags">
                    <span class="material-symbols-outlined">label</span>
                    {post.data.tags.slice(0, 2).join(', ')}
                    {post.data.tags.length > 2 ? `...` : ''}
                  </span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

<style>
.blog-archive {
  padding: 3rem 0;
  min-height: 100vh;
}

.section-title {
  font-size: 2.5rem;
  font-weight: 200;
  margin-bottom: 1rem;
  text-align: center;
  color: var(--md3-on-surface);
}

.section-description {
  font-size: 1.125rem;
  color: var(--md3-on-surface-variant);
  text-align: center;
  margin-bottom: 3rem;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: 2rem;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
  transition: all 0.3s ease-in-out;
}

/* 列表视图样式 */
.blog-list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
  transition: all 0.3s ease-in-out;
}

.blog-list .card {
  display: flex;
  flex-direction: row;
  padding: 1.5rem;
  gap: 1.5rem;
}

.blog-list .card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

/* 响应式调整 */
@media (max-width: 1024px) {
  .blog-grid {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }
}

@media (max-width: 768px) {
  .blog-archive {
    padding: 2rem 0;
  }
  
  .blog-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 0 1rem;
  }
  
  .blog-list {
    padding: 0 1rem;
  }
  
  .blog-list .card {
    flex-direction: column;
    gap: 1rem;
  }
  
  .section-title {
    font-size: 2rem;
  }
  
  .section-description {
    font-size: 1rem;
    margin-bottom: 2rem;
  }
}

@media (max-width: 480px) {
  .blog-grid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 0 0.75rem;
  }
  
  .blog-list {
    padding: 0 0.75rem;
  }
  
  .card {
    padding: 1.25rem;
  }
  
  .section-title {
    font-size: 1.75rem;
  }
}

.card {
  display: block;
  text-decoration: none;
  background-color: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  padding: 1.75rem;
  transition: all 0.3s cubic-bezier(.4,0,.2,1);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  overflow: hidden;
  position: relative;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--bg-primary), var(--bg-secondary));
  transform: scaleX(0);
  transition: transform 0.3s ease;
}

/* 置顶文章样式 */
.card.pinned {
  border-color: var(--accent-color);
}

.card.pinned::before {
  background: linear-gradient(90deg, var(--accent-color), var(--md3-tertiary));
  transform: scaleX(1);
}

.card-pinned {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.375rem 0.875rem;
  background-color: rgba(236, 72, 153, 0.1);
  color: var(--accent-color);
  border-radius: 16px;
  font-size: 0.8rem;
  font-weight: 600;
  align-self: flex-start;
  margin-bottom: -0.25rem;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.02);
  }
}

.card-pinned .material-symbols-outlined {
  font-size: 1rem;
  color: var(--accent-color);
  transform: rotate(45deg);
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: rotate(45deg) translateY(0);
  }
  50% {
    transform: rotate(45deg) translateY(-2px);
  }
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px var(--shadow);
  border-color: var(--accent-color);
}

.card:hover::before {
  transform: scaleX(1);
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.card-category {
  display: inline-block;
  padding: 0.375rem 0.875rem;
  background-color: rgba(16, 185, 129, 0.1);
  color: var(--bg-primary);
  border-radius: 16px;
  font-size: 0.8rem;
  font-weight: 500;
  align-self: flex-start;
  transition: all 0.2s ease;
}

.card:hover .card-category {
  background-color: rgba(16, 185, 129, 0.2);
}

.card-title {
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0;
  color: var(--md3-on-surface);
  transition: color 0.3s ease;
  line-height: 1.3;
}

.card:hover .card-title {
  color: var(--md3-primary);
}

.card-excerpt {
  color: var(--md3-on-surface-variant);
  line-height: 1.6;
  margin: 0;
  font-size: 0.95rem;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  color: var(--md3-on-surface-variant);
  font-size: 0.85rem;
  margin-top: 0.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--glass-border);
}

.card-date,
.card-tags {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.card-tags .material-symbols-outlined {
  font-size: 1rem;
}

.material-symbols-outlined {
  font-family: 'Material Symbols Outlined', sans-serif;
  font-size: 1rem;
  color: var(--md3-on-surface-variant);
}
</style>
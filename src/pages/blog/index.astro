---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const title = '博客归档';
const description = 'XingGreen Blog的所有博客文章';

// 获取所有博客文章并按日期排序
const blogPosts = await getCollection('blog');

// 手动排序博客文章：置顶文章优先，然后按优先级，最后按日期
blogPosts.sort((a, b) => {
  const now = new Date();
  
  // 检查过期时间：如果文章已过期且设置了过期日期，则取消置顶
  const isAPinned = a.data.pin && (!a.data.expiryDate || new Date(a.data.expiryDate) > now);
  const isBPinned = b.data.pin && (!b.data.expiryDate || new Date(b.data.expiryDate) > now);
  
  // 置顶文章优先
  if (isAPinned && !isBPinned) return -1;
  if (!isAPinned && isBPinned) return 1;
  
  // 如果都是置顶文章，按优先级排序（数字越大优先级越高）
  if (isAPinned && isBPinned) {
    if (a.data.priority !== b.data.priority) {
      return b.data.priority - a.data.priority;
    }
  }
  
  // 最后按日期排序
  const dateA = new Date(a.data.date).valueOf();
  const dateB = new Date(b.data.date).valueOf();
  return dateB - dateA;
});

// 按年份和月份对博客文章进行分组
const groupedPosts = blogPosts.reduce((acc, post) => {
  const postDate = new Date(post.data.date);
  const year = postDate.getFullYear();
  const month = postDate.getMonth() + 1; // 月份从0开始，所以加1
  
  if (!acc[year]) {
    acc[year] = {};
  }
  
  if (!acc[year][month]) {
    acc[year][month] = [];
  }
  
  acc[year][month].push(post);
  return acc;
}, {});

// 将分组后的文章转换为数组，方便遍历
const years = Object.keys(groupedPosts).sort((a, b) => b - a); // 按年份降序排序

// 月份名称映射
const monthNames = [
  '一月', '二月', '三月', '四月', '五月', '六月',
  '七月', '八月', '九月', '十月', '十一月', '十二月'
];
---

<MainLayout title={title} description={description}>
  <section class="blog-archive">
    <div class="container">
      <h2 class="section-title">博客归档</h2>
      <p class="section-description">这里是{title}的所有博客文章，共{blogPosts.length}篇。</p>
      <button id="add-post-btn" class="add-post-btn btn-gummy">
        <span class="material-symbols-outlined">add</span>
        添加新文章
      </button>
      <div id="blog-container" class="timeline">
        {years.map(year => {
          const months = Object.keys(groupedPosts[year]).sort((a, b) => b - a); // 按月份降序排序
          return months.map(month => (
            <div key={`${year}-${month}`} class="timeline-year-month">
              <div class="timeline-year-month-label">
                <h3>{year}年 {monthNames[parseInt(month) - 1]}</h3>
              </div>
              <div class="timeline-items">
                {groupedPosts[year][month].map(post => (
                  <div key={post.slug} class="timeline-item">
                    <div class="timeline-marker"></div>
                    <div class="timeline-content">
                      <div class="timeline-date">
                        <span class="material-symbols-outlined">calendar_today</span>
                        {new Date(post.data.date).toLocaleDateString('zh-CN', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric'
                        })}
                      </div>
                      <a href={`/blog/${post.slug}`} class="timeline-title" aria-label={`阅读文章：${post.data.title}`}>
                        {post.data.pin && (!post.data.expiryDate || new Date(post.data.expiryDate) > new Date()) && (
                          <span class="timeline-pin">
                            <span class="material-symbols-outlined">push_pin</span>
                          </span>
                        )}
                        {post.data.title}
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ));
        })}
      </div>
    </div>
  </section>
  <!-- 编辑器模态框 -->
  <div id="editor-modal" class="editor-modal">
    <div class="editor-modal-content">
      <div class="editor-header">
        <h3>编写新文章</h3>
        <button id="close-editor" class="close-btn">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="editor-body">
        <form id="post-form" class="post-form">
          <div class="form-group">
            <label for="post-title">标题</label>
            <input type="text" id="post-title" name="title" required placeholder="请输入文章标题">
          </div>
          <div class="form-group">
            <label for="post-excerpt">摘要</label>
            <textarea id="post-excerpt" name="excerpt" rows="3" required placeholder="请输入文章摘要"></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="post-category">分类</label>
              <input type="text" id="post-category" name="category" required placeholder="请输入文章分类">
            </div>
            <div class="form-group">
              <label for="post-author">作者</label>
              <input type="text" id="post-author" name="author" required placeholder="请输入作者姓名">
            </div>
            <div class="form-group">
              <label for="post-tags">标签（用逗号分隔）</label>
              <input type="text" id="post-tags" name="tags" placeholder="请输入文章标签，用逗号分隔">
            </div>
          </div>
          <div class="form-group">
            <label for="post-content">内容</label>
            <textarea id="post-content" name="content" placeholder="请输入文章内容（支持Markdown格式）"></textarea>
          </div>
          <div class="editor-footer">
            <button type="submit" class="save-btn">保存文章</button>
            <button type="button" id="export-btn" class="export-btn">导出Markdown</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 引入SimpleMDE CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simplemde@1.11.2/dist/simplemde.min.css">

  <!-- 引入jQuery和SimpleMDE JS -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/simplemde@1.11.2/dist/simplemde.min.js"></script>

  <script>
    // 初始化编辑器
    let simplemde;
    
    // 页面加载完成后初始化
    document.addEventListener('DOMContentLoaded', function() {
      // 初始化SimpleMDE编辑器
      simplemde = new SimpleMDE({
        element: document.getElementById('post-content'),
        toolbar: [
          'bold', 'italic', 'heading', '|',
          'quote', 'code', 'table', 'horizontal-rule', '|',
          'unordered-list', 'ordered-list', '|',
          'link', 'image', '|',
          'preview', 'side-by-side', 'fullscreen', '|',
          'guide'
        ],
        spellChecker: false,
        placeholder: '请输入文章内容（支持Markdown格式）'
      });
      
      // 获取元素
      const addPostBtn = document.getElementById('add-post-btn');
      const editorModal = document.getElementById('editor-modal');
      const closeEditor = document.getElementById('close-editor');
      const postForm = document.getElementById('post-form');
      const exportBtn = document.getElementById('export-btn');
      
      // 打开编辑器
      addPostBtn.addEventListener('click', function() {
        editorModal.style.display = 'flex';
        // 聚焦到标题输入框
        document.getElementById('post-title').focus();
      });
      
      // 关闭编辑器
      closeEditor.addEventListener('click', function() {
        editorModal.style.display = 'none';
        // 重置表单
        postForm.reset();
        simplemde.value('');
      });
      
      // 点击模态框外部关闭
      window.addEventListener('click', function(event) {
        if (event.target == editorModal) {
          editorModal.style.display = 'none';
          // 重置表单
          postForm.reset();
          simplemde.value('');
        }
      });
      
      // 导出Markdown
      exportBtn.addEventListener('click', function() {
        const title = document.getElementById('post-title').value;
        const excerpt = document.getElementById('post-excerpt').value;
        const category = document.getElementById('post-category').value;
        const author = document.getElementById('post-author').value;
        const tagsInput = document.getElementById('post-tags').value;
        const tags = tagsInput.split(',').map(tag => tag.trim()).filter(tag => tag);
        const content = simplemde.value();
        
        // 创建Markdown内容（包括Frontmatter）
        const frontmatter = `---
title: "${title}"
excerpt: "${excerpt}"
date: "${new Date().toISOString().split('T')[0]}"
category: "${category}"
tags: [${tags.map(tag => `"${tag}"`).join(', ')}]
author: "${author}"
pin: false
priority: 1
---

${content}`;
        
        // 创建下载链接
        const blob = new Blob([frontmatter], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${title.replace(/\s+/g, '-').toLowerCase()}.md`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
      
      // 保存文章（这里只是演示，实际项目需要后端API）
      postForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        // 获取表单数据
        const formData = new FormData(postForm);
        const content = simplemde.value();
        
        // 创建文章对象
        const post = {
          title: formData.get('title'),
          excerpt: formData.get('excerpt'),
          category: formData.get('category'),
          author: formData.get('author'),
          tags: formData.get('tags').split(',').map(tag => tag.trim()).filter(tag => tag),
          content: content,
          date: new Date().toISOString().split('T')[0]
        };
        
        // 这里可以添加保存到后端的逻辑
        console.log('文章数据:', post);
        
        // 显示成功消息
        alert('文章保存成功！');
        
        // 关闭编辑器并重置表单
        editorModal.style.display = 'none';
        postForm.reset();
        simplemde.value('');
      });
    });
  </script>

</MainLayout>

<style>
.blog-archive {
  padding: 3rem 0;
  min-height: 100vh;
}

.section-title {
  font-size: 2.5rem;
  font-weight: 600;
  margin-bottom: 1rem;
  text-align: center;
  color: var(--text-primary);
  font-family: var(--font-family-title);
  background: var(--accent-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: 0 0 20px rgba(236, 72, 153, 0.3);
}

.section-description {
  font-size: 1.125rem;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 3rem;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
  font-family: var(--font-family-body);
}

.timeline {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
  position: relative;
}

/* 年份月份标签样式 */
.timeline-year-month {
  margin-bottom: 3rem;
}

.timeline-year-month-label {
  background: var(--accent-gradient);
  color: white;
  padding: 0.75rem 1.5rem;
  border-radius: var(--border-radius-lg);
  margin-bottom: 1.5rem;
  display: inline-block;
  box-shadow: var(--shadow-concave-convex);
  border: 2px solid var(--accent-primary);
  font-family: var(--font-family-title);
}

.timeline-year-month-label h3 {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 600;
  text-shadow: 0 0 10px rgba(236, 72, 153, 0.5);
}

/* 时间线项目容器 */
.timeline-items {
  position: relative;
  padding-left: 2rem;
}

/* 时间线竖线 */
.timeline-items::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--accent-gradient);
  border-radius: 2px;
  box-shadow: 0 0 15px rgba(236, 72, 153, 0.5);
  z-index: 1;
}

/* 单个时间线项目 */
.timeline-item {
  position: relative;
  margin-bottom: 2rem;
  display: flex;
  align-items: flex-start;
}

/* 时间线标记点 */
.timeline-marker {
  position: absolute;
  left: -2rem;
  top: 0.5rem;
  width: 16px;
  height: 16px;
  background: var(--accent-gradient);
  border: 3px solid var(--bg-primary);
  border-radius: 50%;
  z-index: 2;
  box-shadow: 0 0 0 2px var(--accent-primary), 0 2px 12px rgba(236, 72, 153, 0.4);
  transition: all 0.3s cubic-bezier(.4,0,.2,1);
}

/* 单个时间线项目hover效果 */
.timeline-item:hover .timeline-marker {
  transform: scale(1.5);
  box-shadow: 0 0 0 3px var(--accent-primary), 0 4px 20px rgba(236, 72, 153, 0.6);
}

/* 时间线内容 */
.timeline-content {
  flex: 1;
  background-color: var(--bg-primary);
  padding: 1.25rem 1.75rem;
  border-radius: var(--border-radius-lg);
  border-left: 3px solid transparent;
  box-shadow: var(--shadow-concave-convex);
  border: 2px solid var(--border-color);
  transition: all 0.3s cubic-bezier(.4,0,.2,1);
  position: relative;
  overflow: hidden;
}

.timeline-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--accent-gradient);
  transform: scaleX(0);
  transition: transform 0.3s ease;
}

.timeline-item:hover .timeline-content {
  background-color: var(--bg-secondary);
  border-left-color: var(--accent-primary);
  transform: translateX(8px);
  box-shadow: var(--shadow-lg);
  border-color: var(--accent-primary);
}

.timeline-item:hover .timeline-content::before {
  transform: scaleX(1);
}

/* 时间线日期 */
.timeline-date {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--text-secondary);
  font-size: 0.875rem;
  margin-bottom: 0.5rem;
  font-weight: 400;
  font-family: var(--font-family-body);
}

.timeline-date .material-symbols-outlined {
  font-size: 1rem;
  color: var(--accent-primary);
  text-shadow: 0 0 5px rgba(236, 72, 153, 0.5);
}

/* 时间线标题 */
.timeline-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--text-primary);
  font-size: 1.25rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(.4,0,.2,1);
  line-height: 1.4;
  font-family: var(--font-family-title);
}

.timeline-title:hover {
  color: var(--accent-primary);
  transform: translateX(4px);
  text-shadow: 0 0 10px rgba(236, 72, 153, 0.5);
}

/* 置顶标记 */
.timeline-pin {
  color: var(--accent-primary);
  text-shadow: 0 0 10px rgba(236, 72, 153, 0.8);
  animation: glow 2s ease-in-out infinite alternate;
}

.timeline-pin .material-symbols-outlined {
  font-size: 1rem;
  transform: rotate(45deg);
  animation: spin 4s linear infinite;
}

@keyframes glow {
  from {
    text-shadow: 0 0 10px rgba(236, 72, 153, 0.8);
  }
  to {
    text-shadow: 0 0 20px rgba(236, 72, 153, 1), 0 0 30px rgba(236, 72, 153, 0.5);
  }
}

@keyframes spin {
  from {
    transform: rotate(45deg);
  }
  to {
    transform: rotate(405deg);
  }
}

/* 列表视图样式（保留兼容） */
.blog-list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
  transition: all 0.3s ease-in-out;
}

/* 响应式调整 */
@media (max-width: 1024px) {
  .timeline {
    padding: 0 1.25rem;
  }
}

@media (max-width: 768px) {
  .blog-archive {
    padding: 2rem 0;
  }
  
  .timeline {
    padding: 0 1rem;
  }
  
  .timeline-year-month-label {
    padding: 0.625rem 1.25rem;
  }
  
  .timeline-year-month-label h3 {
    font-size: 1.125rem;
  }
  
  .timeline-items {
    padding-left: 1.5rem;
  }
  
  .timeline-marker {
    left: -1.5rem;
    width: 10px;
    height: 10px;
  }
  
  .timeline-content {
    padding: 0.875rem 1.25rem;
  }
  
  .timeline-title {
    font-size: 1.125rem;
  }
  
  .blog-list {
    padding: 0 1rem;
  }
  
  .blog-list .card {
    flex-direction: column;
    gap: 1rem;
  }
  
  .section-title {
    font-size: 2rem;
  }
  
  .section-description {
    font-size: 1rem;
    margin-bottom: 2rem;
  }
}

@media (max-width: 480px) {
  .timeline {
    padding: 0 0.75rem;
  }
  
  .timeline-year-month {
    margin-bottom: 2rem;
  }
  
  .timeline-year-month-label {
    padding: 0.5rem 1rem;
    border-radius: 6px;
  }
  
  .timeline-year-month-label h3 {
    font-size: 1rem;
  }
  
  .timeline-items {
    padding-left: 1.25rem;
  }
  
  .timeline-marker {
    left: -1.25rem;
    width: 8px;
    height: 8px;
  }
  
  .timeline-content {
    padding: 0.75rem 1rem;
  }
  
  .timeline-title {
    font-size: 1rem;
  }
  
  .timeline-date {
    font-size: 0.8125rem;
  }
  
  .blog-list {
    padding: 0 0.75rem;
  }
  
  .card {
    padding: 1.25rem;
  }
  
  .section-title {
    font-size: 1.75rem;
  }
}

.card {
  display: block;
  text-decoration: none;
  background-color: var(--bg-primary);
  border: 2px solid var(--border-color);
  border-radius: var(--border-radius-lg);
  padding: 1.75rem;
  transition: all 0.3s cubic-bezier(.4,0,.2,1);
  overflow: hidden;
  position: relative;
  box-shadow: var(--shadow-concave-convex);
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: var(--accent-gradient);
  transform: scaleX(0);
  transition: transform 0.3s ease;
}

/* 置顶文章样式 */
.card.pinned {
  border-color: var(--accent-primary);
  box-shadow: 0 0 20px rgba(236, 72, 153, 0.3);
}

.card.pinned::before {
  background: var(--accent-gradient);
  transform: scaleX(1);
}

.card-pinned {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.375rem 0.875rem;
  background-color: rgba(236, 72, 153, 0.1);
  color: var(--accent-primary);
  border-radius: 16px;
  font-size: 0.8rem;
  font-weight: 600;
  align-self: flex-start;
  margin-bottom: -0.25rem;
  animation: pulse 2s infinite;
  font-family: var(--font-family-body);
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
    box-shadow: 0 0 5px rgba(236, 72, 153, 0.3);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.02);
    box-shadow: 0 0 15px rgba(236, 72, 153, 0.5);
  }
}

.card-pinned .material-symbols-outlined {
  font-size: 1rem;
  color: var(--accent-primary);
  transform: rotate(45deg);
  animation: float 3s ease-in-out infinite;
  text-shadow: 0 0 5px rgba(236, 72, 153, 0.8);
}

@keyframes float {
  0%, 100% {
    transform: rotate(45deg) translateY(0);
  }
  50% {
    transform: rotate(45deg) translateY(-2px);
  }
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
  border-color: var(--accent-primary);
}

.card:hover::before {
  transform: scaleX(1);
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.card-category {
  display: inline-block;
  padding: 0.375rem 0.875rem;
  background-color: rgba(236, 72, 153, 0.1);
  color: var(--accent-primary);
  border-radius: 16px;
  font-size: 0.8rem;
  font-weight: 500;
  align-self: flex-start;
  transition: all 0.2s ease;
  font-family: var(--font-family-body);
  border: 1px solid var(--accent-primary);
}

.card:hover .card-category {
  background-color: rgba(236, 72, 153, 0.2);
  transform: translateY(-2px);
}

.card-title {
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0;
  color: var(--text-primary);
  transition: color 0.3s ease;
  line-height: 1.3;
  font-family: var(--font-family-title);
}

.card:hover .card-title {
  color: var(--accent-primary);
  text-shadow: 0 0 10px rgba(236, 72, 153, 0.5);
}

.card-excerpt {
  color: var(--text-secondary);
  line-height: 1.6;
  margin: 0;
  font-size: 0.95rem;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-family: var(--font-family-body);
}

.card-meta {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  color: var(--text-secondary);
  font-size: 0.85rem;
  margin-top: 0.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-color);
  font-family: var(--font-family-body);
}

.card-date,
.card-tags {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.card-tags .material-symbols-outlined {
  font-size: 1rem;
  color: var(--accent-primary);
}

.material-symbols-outlined {
  font-family: 'Material Symbols Outlined', sans-serif;
  font-size: 1rem;
